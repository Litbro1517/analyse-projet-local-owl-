# =============================================
# OWL - Environment Variables (confined mode)
# =============================================
# GEMINI_API_KEY is the canonical key for the Gemini SDK.
# GOOGLE_API_KEY is kept as an alias for SearchToolkit / SearchEngine.
# Both MUST share the same value to prevent "Build failed" errors.
# =============================================

GEMINI_API_KEY='Your_Key'
GOOGLE_API_KEY='Your_Key'
SEARCH_ENGINE_ID='Your_ID'
